{
  "cases": [
    {
      "id": "terminal-display-options-combined",
      "source": "- ParentLong\n  - [x] ChildLong\n  - [ ] pending\n",
      "argv": [
        "tasks.md",
        "--tree",
        "--format=decimal",
        "--precision",
        "3",
        "--no-trailing-zeros",
        "--max-label-clusters=5",
        "--no-color",
        "--no-pager"
      ],
      "expected": {
        "status": 0,
        "readerPaths": [
          "tasks.md"
        ],
        "diagnostics": [],
        "report": {
          "sourcePath": "tasks.md",
          "frontmatter": [],
          "frontmatterPresent": false,
          "markdownPresent": true,
          "presentation": "separate",
          "frontmatterWeight": null,
          "markdown": {
            "rootCount": 1,
            "explicitCheckboxCount": 2,
            "implicitNodeCount": 1,
            "nodeCount": 3,
            "completedEquivalent": 0.5,
            "progress": 0.5,
            "percentage": 50,
            "rootLabels": [
              "ParentLong"
            ]
          },
          "progress": {
            "rootCount": 1,
            "explicitCheckboxCount": 2,
            "implicitNodeCount": 1,
            "nodeCount": 3,
            "completedEquivalent": 0.5,
            "progress": 0.5,
            "percentage": 50,
            "rootLabels": [
              "ParentLong"
            ]
          }
        },
        "terminal": {
          "mode": "tree",
          "options": {
            "maxLabelClusters": 5,
            "ellipsis": "...",
            "truncate": true,
            "progressFormat": "decimal",
            "precision": 3,
            "showTrailingZeros": false
          },
          "print": [
            {
              "tag": "report",
              "options": {
                "color": "never",
                "pager": "never",
                "target": "stdout"
              }
            }
          ]
        }
      }
    },
    {
      "id": "weighted-frontmatter-details-combination",
