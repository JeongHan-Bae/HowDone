{
  "positive": [
    {
      "id": "mixed-markdown-boundaries",
      "source": "---\ntitle: Mixed fixture\n---\n\n# Ignored heading\n\n- Root\n  - [x] done\n  - [ ] pending\n\n> - [x] quoted\n\n```md\n- [x] code\n```\n\n| [x] | text |\n| --- | --- |\n| [ ] | table |\n",
      "coverage": [
        "yaml-frontmatter",
        "heading",
        "unordered-list",
        "task-list",
        "blockquote",
        "code-block",
        "table",
        "implicit-node",
        "explicit-leaf"
      ],
      "expectedTokenKinds": [
        "frontmatter",
        "syntax-node",
        "syntax-node",
        "syntax-node",
        "syntax-node",
        "syntax-node",
        "eof"
      ],
      "expectedSyntaxNodeTypes": [
        "heading",
        "list",
        "blockquote",
        "code-block",
        "table"
      ],
      "expectedAstTypes": [
        "heading",
        "list",
        "blockquote",
        "code-block",
        "table"
      ],
      "expectedRoots": [
        {
          "label": "Root",
          "checked": null,
          "implicit": true,
          "progress": 0,
          "depth": 0,
          "children": [
            {
              "label": "done",
              "checked": true,
              "implicit": false,
              "progress": 0,
              "depth": 1,
              "children": []
            },
            {
              "label": "pending",
              "checked": false,
              "implicit": false,
              "progress": 0,
              "depth": 1,
              "children": []
            }
          ]
        }
      ],
      "expectedMetrics": {
        "rootCount": 1,
        "explicitCheckboxCount": 2,
        "implicitNodeCount": 1,
        "nodeCount": 3,
        "completedEquivalent": 0.5,
        "progress": 0.5,
        "percentage": 50
      }
    },
