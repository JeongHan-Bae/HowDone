{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": false,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
