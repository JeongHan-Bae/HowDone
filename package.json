{
  "name": "howdone-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "HowDone workspace containing the hexagonal core and primary CLI product.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeongHan-Bae/HowDone.git"
  },
  "bugs": {
    "url": "https://github.com/JeongHan-Bae/HowDone/issues"
  },
  "homepage": "https://github.com/JeongHan-Bae/HowDone#readme",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "start": "node ./bin/howdone.cjs",
    "badge:version": "node ./scripts/update-version-badge.mjs",
    "build": "node ./scripts/sync-package-artifacts.mjs && tsc --project tsconfig.build.json",
    "build:cli": "npm run build && tsc --project tsconfig.cli-build.json",
    "build:tests": "node ./scripts/build-test-artifacts.mjs",
    "check:ascii": "node --import tsx ./scripts/check-ascii.ts",
    "clean": "node ./scripts/clean.mjs",
    "install:local": "node ./scripts/install-local.mjs",
    "test:tdd": "node ./scripts/run-source-tests.mjs",
    "test:tdd:compiled": "node ./scripts/run-compiled-tests.mjs tdd",
    "test:package": "node ./scripts/run-compiled-tests.mjs package",
    "test": "npm run test:tdd",
    "test:bdd": "node ./scripts/run-cucumber.mjs source",
    "test:bdd:compiled": "node ./scripts/run-compiled-tests.mjs bdd",
    "test:compiled": "node ./scripts/run-compiled-tests.mjs all",
    "test:local-install": "node ./scripts/run-compiled-tests.mjs local-install",
    "test:all": "npm test && npm run test:bdd && npm run test:compiled && npm run test:local-install",
    "typecheck": "tsc --noEmit",
    "typecheck:maintenance": "node --import tsx ./scripts/typecheck-maintenance.ts .",
    "check:static": "npm run typecheck && npm run typecheck:maintenance && npm run check:platform && npm run check:relative-imports && npm run check:ascii && git diff --check && git diff --cached --check && node -e \"console.log('Git whitespace checks passed.')\"",
    "verify:precommit": "npm run clean && npm run test:all && npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=moderate && npm run pack:check && npm run check:static",
    "check:help": "node --conditions=source --import tsx ./scripts/check-cli-help.ts",
    "check:platform": "node --import tsx ./scripts/check-platform-neutral.ts",
    "check:relative-imports": "node --import tsx ./scripts/check-relative-imports.ts",
    "pack:check": "npm run build:cli && node --import tsx ./scripts/check-package-contents.ts"
  },
  "engines": {
    "node": ">=18.18"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "18.3.18",
    "chalk": "5.6.2",
    "string-width": "7.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "glob": "13.0.6",
    "uuid": "11.1.1"
  }
}
